DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Microservicio Node (Django lo consume)
NODE_SERVICE_URL=http://127.0.0.1:3000

# Google Gemini — pega aquí tu API key cuando la tengas
GEMINI_API_KEY=TU_API_KEY_AQUI
GEMINI_MODEL=gemini-3.5-flash-lite
